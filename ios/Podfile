# 스윙봄 iOS Podfile
# ⓒ 찐골프(JJIN Golf) / 개발자 : 찬이작업실
#
# 이 파일을 저장소에 직접 넣는 이유
#   Windows 에서는 Flutter 가 Podfile 을 생성하지 않는다.
#   자동 생성되는 기본 Podfile 은 platform 줄이 주석 처리되어 있어
#   ffmpeg_kit_flutter_new 가 요구하는 iOS 14.0 을 맞추지 못하고 빌드가 실패한다.
#
# 최소 버전을 바꿀 때는 아래 세 곳을 **함께** 고쳐야 한다.
#   1) 이 파일의 platform :ios
#   2) ios/Runner.xcodeproj/project.pbxproj 의 IPHONEOS_DEPLOYMENT_TARGET (3곳)
#   3) post_install 의 IPHONEOS_DEPLOYMENT_TARGET

platform :ios, '14.0'

# CocoaPods 분석 출력을 줄인다
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(
    File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__
  )
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. " \
          "If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. " \
        "Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # 개별 Pod 이 더 낮은 버전으로 되돌리는 것을 막는다.
      # 이것이 없으면 일부 Pod 이 12.0 으로 빌드되어 ffmpeg 와 충돌한다.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'

      # 서명 없이 빌드하므로 Pod 쪽 서명도 끈다.
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
      config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
      config.build_settings['CODE_SIGN_IDENTITY'] = ''
    end
  end
end
